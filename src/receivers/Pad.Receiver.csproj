<Project Sdk="Microsoft.NET.Sdk">

	<!-- Receiver (P3): se conecteaza la broker, trimite HELLO cu abonarile, primeste mesaje,
       le proceseaza (afiseaza + scrie in fisier), deduplica dupa messageId si trimite ACK. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Pad.Receiver</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\common\Pad.Common.csproj" />
	</ItemGroup>

</Project>